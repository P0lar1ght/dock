# Copy to ~/.dock/config.toml (user) or .dock/config.toml (project).
# Project file wins when both exist. Re-read on every /model and Settings open.
#
# **没有配置文件 = 没有模型。** dock 不内置任何厂商条目，也不按模型名猜能力。
# 下面三段分别是三条 wire 的最小可用配置，把 <...> 换成你自己的端点与模型名。
#
# 连接
#   api_base_url  OpenAI 兼容的基址。请求路径 = api_base_url + /chat/completions
#                 | /responses | /messages，按 api_backend 决定。
#   api_backend   chat_completions（默认）| responses | messages
#   api_model     发给上游的 slug；省略则用目录 id（`[model."<id>"]` 里的 id）。
#                 同一模型想在 /model 里出现多行（比如测三条协议）就靠它。
#   env_key       读哪个环境变量取密钥。**首选这个**，别把密钥写进文件。
#   api_key       行内密钥；写了就优先于 env_key。仅用于本地临时测试。
#   auth_scheme   bearer（默认）| x_api_key。messages 默认 x-api-key；走第三方
#                 网关的 /messages 通常仍是 bearer，那就显式写 bearer。
#   Dotted / slashed id 必须加引号：[model."vendor/model-name"]
#   DOCK_MODEL 环境变量在启动时覆盖 [models].default。
#
# 能力 / 默认值——**不写就不发这个参数**，交给上游自己的默认。不同模型的差异
# 写在这里，不写死在 dock 里：
#   context_window     上下文窗口（顶栏占用与自动压缩的分母）。不写按 128k 估。
#   max_output_tokens  单次输出上限。不写不发；messages 后端例外——协议要求必填，
#                      不写兜底 16384。
#   reasoning          false = 这个模型没有推理档，任何推理字段都不发，/think 也
#                      扳不动它。不写 = 跟着运行时 /think 开关走。
#   reasoning_effort   切到该模型时的默认强度。不写 = 不发，用上游默认。
#   reasoning_efforts  /effort 菜单列哪几档。不写 = 列通用四档
#                      (low/medium/high/xhigh)；写 [] = 会推理但不接受档位参数，
#                      菜单空着、永不发 effort。
#   supports_images    false = 纯文本模型，图片（含工具结果里的截图）不进请求体。
#                      不写 = 当作支持。
#   prompt_cache       仅 messages 后端：true（默认）往 system / 对话尾部打
#                      cache_control 断点，长会话每轮省掉重复前缀的计费。自建
#                      /v1/messages 代理不认这个字段时置 false。另两条 wire 的
#                      前缀缓存由上游自动做，这个键对它们无效。

[models]
default = "chat-model"

# --- 1. Chat Completions（最通用，绝大多数端点都支持这条） ---
[model."chat-model"]
name = "Chat 模型"
description = "<厂商> /chat/completions"
api_base_url = "https://<your-endpoint>/v1"
api_backend = "chat_completions"
env_key = "YOUR_API_KEY_ENV"
context_window = 128000

# --- 2. Responses（OpenAI 风格；推理链能跨轮回放，推理模型优先走这条） ---
[model."responses-model"]
name = "Responses 模型"
description = "<厂商> /responses"
api_base_url = "https://<your-endpoint>/v1"
api_backend = "responses"
api_model = "<上游真实模型名>"
env_key = "YOUR_API_KEY_ENV"
context_window = 200000
reasoning = true
reasoning_effort = "medium"
reasoning_efforts = ["low", "medium", "high"]

# --- 3. Messages（Anthropic 风格；max_tokens 必填，缓存要显式断点） ---
[model."messages-model"]
name = "Messages 模型"
description = "<厂商> /messages"
api_base_url = "https://<your-endpoint>/v1"
api_backend = "messages"
api_model = "<上游真实模型名>"
# 直连 Anthropic 风格端点可省略（默认 x-api-key）；第三方网关多半要 bearer。
auth_scheme = "x_api_key"
env_key = "YOUR_API_KEY_ENV"
context_window = 200000
max_output_tokens = 16384
prompt_cache = true

# 纯文本模型的写法：明确关掉图片，否则截图类工具结果会被塞进请求体。
# [model."text-only-model"]
# api_base_url = "https://<your-endpoint>/v1"
# env_key = "YOUR_API_KEY_ENV"
# supports_images = false
# reasoning = false

# --- Computer / CUA: trycua cua-driver MCP (stdio) ---
# Install cua-driver on the host, then enable this block.
# Tools appear as mcp_cua-driver__* (search_tool / use_tool); all gated like bash.
# Prefer PATH (`cua-driver`); or paste the absolute command from `cua-driver mcp-config`.
# Linux needs X11/XWayland (+ AT-SPI for get_window_state). No Docker.
# cua-driver 0.24+ speaks NDJSON. Dock stdio defaults to ndjson (no framing key needed).
# Legacy Content-Length servers only: framing = "content-length"
#
# [mcp_servers.cua-driver]
# command = "cua-driver"
# args = ["mcp"]
# enabled = true

# --- Browser / BUA Chromium display ---
# Default headless (CI-safe). Toggle from /browser with `h`, or set here.
# DOCK_BROWSER_HEADED (any non-empty) overrides to headed at launch; empty/unset → use [browser].headed.
#
# [browser]
# headed = false
