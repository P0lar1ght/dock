# Copy to ~/.dock/config.toml (user) or .dock/config.toml (project).
# Project file wins when both exist. Re-read on every /model and Settings open.
#
# Dotted ids must be quoted: [model."gpt-4.1"]
# DOCK_MODEL still overrides [models].default at boot.
# Per-model api_base_url / api_key (Grok shape) so free endpoints can sit
# next to xAI without a global DOCK_API_BASE.
# api_backend: chat_completions (default) | responses | messages
# api_model: 发给上游的 slug；省略则用目录 id。同一模型测三条协议时用这个。
# auth_scheme: bearer (default) | x_api_key  — messages 默认 x-api-key；走 OpenRouter 请显式 bearer。

[models]
default = "minimax/minimax-m3:free"

[[models.catalog]]
id = "grok-4"
name = "Grok 4"
description = "xAI"

# Adds or overrides a catalog row (Grok [model.<id>] shape).
[model.grok-4]
name = "Grok 4 pinned"

# OpenRouter free — fill api_key or set OPENROUTER_API_KEY.
# Same slug, three wires: picker id 可以不同，api_model 才是发给上游的名字。
[model."minimax/minimax-m3:free"]
name = "MiniMax M3 · chat"
description = "OpenRouter /chat/completions"
api_base_url = "https://openrouter.ai/api/v1"
api_backend = "chat_completions"
env_key = "OPENROUTER_API_KEY"
api_key = ""

[model."minimax-m3-responses"]
name = "MiniMax M3 · responses"
description = "OpenRouter /responses"
api_base_url = "https://openrouter.ai/api/v1"
api_backend = "responses"
api_model = "minimax/minimax-m3:free"
auth_scheme = "bearer"
env_key = "OPENROUTER_API_KEY"

[model."minimax-m3-messages"]
name = "MiniMax M3 · messages"
description = "OpenRouter /messages"
api_base_url = "https://openrouter.ai/api/v1"
api_backend = "messages"
api_model = "minimax/minimax-m3:free"
auth_scheme = "bearer"
env_key = "OPENROUTER_API_KEY"

# Empero community endpoint — prompts are stored (IP hash). Key can be anything.
[model."glm-5.3-flash"]
name = "GLM 5.3 Flash"
description = "Empero free (logged)"
api_base_url = "https://free.empero.org/v1"
api_key = "free"

[model."qwen3.8-flash"]
name = "Qwen3.8 Flash-Next"
description = "Empero free (logged)"
api_base_url = "https://free.empero.org/v1"
api_key = "free"

# Anthropic Messages (or a proxy that speaks /v1/messages).
# [model.claude-sonnet-4]
# api_base_url = "https://api.anthropic.com/v1"
# api_backend = "messages"
# env_key = "ANTHROPIC_API_KEY"

# OpenAI Responses.
# [model."gpt-4.1"]
# api_base_url = "https://api.openai.com/v1"
# api_backend = "responses"
# env_key = "OPENAI_API_KEY"

# --- Computer / CUA: trycua cua-driver MCP (stdio) ---
# Install cua-driver on the host, then enable this block.
# Tools appear as mcp_cua-driver__* (search_tool / use_tool); all gated like bash.
# Prefer PATH (`cua-driver`); or paste the absolute command from `cua-driver mcp-config`.
# Linux needs X11/XWayland (+ AT-SPI for get_window_state). No Docker.
# cua-driver 0.24+ speaks NDJSON (one JSON-RPC object per line), not Content-Length.
# Default framing = "auto" detects that; set framing = "ndjson" to skip probing.
#
# [mcp_servers.cua-driver]
# command = "cua-driver"
# args = ["mcp"]
# enabled = true
# framing = "ndjson"   # optional; auto works

