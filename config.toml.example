# Copy to ~/.dock/config.toml (user) or .dock/config.toml (project).
# Project file wins when both exist. Re-read on every /model and Settings open.
#
# **没有配置文件 = 没有模型。** dock 不内置任何厂商条目，也不按模型名猜能力。
# 下面三段分别是三条 wire 的最小可用配置，把 <...> 换成你自己的端点与模型名。
#
# 连接
#   api_base_url  OpenAI 兼容的基址。请求路径 = api_base_url + /responses |
#                 /chat/completions | /messages，按当前协议决定。
#   api_backends  这个端点**支持哪几条协议**，列表，第一条 = 切到该模型时的默认。
#                 一个端点常常同时开着 /responses 和 /chat/completions：声明成
#                 一行，运行时用 /protocol 在这几条之间切，不用为了换协议再配
#                 一个只有协议不同的重复模型条目。
#                 可选值 responses | chat_completions | messages。
#   api_backend   单数写法 = 只支持这一条。不写默认 responses。
#                 两个键都写时，单数当默认提到队首（老配置补一行 api_backends
#                 不会换掉原来的默认协议）。
#   api_model     发给上游的 slug；省略则用目录 id（`[model."<id>"]` 里的 id）。
#   env_key       读哪个环境变量取密钥。**首选这个**，别把密钥写进文件。
#   api_key       行内密钥；写了就优先于 env_key。仅用于本地临时测试。
#   auth_scheme   bearer | x_api_key。不写就跟着**当前协议**走：messages 用
#                 x-api-key，另两条用 bearer。走第三方网关的 /messages 通常仍是
#                 bearer，那就显式写 bearer。
#   Dotted / slashed id 必须加引号：[model."vendor/model-name"]
#   DOCK_MODEL 环境变量在启动时覆盖 [models].default。
#
# 协议块 [model."<id>".<协议>]——同一个端点各协议入口不同时用它。可覆盖三个
# **连接**键：api_base_url / auth_scheme / api_model。优先级：协议块 > 模型级 >
# 协议默认。协议名用 responses / chat_completions / messages（别名 resp / chat /
# anthropic）。能力键（context_window、reasoning、supports_images…）是模型的属性，
# 不随协议变，只能写在模型级，这样才守得住「一个模型一条 entry」。
#   典型：DeepSeek 的 OpenAI 侧是 https://api.deepseek.com，
#         Anthropic 侧是 https://api.deepseek.com/anthropic。
#
# 能力 / 默认值——**不写就不发这个参数**，交给上游自己的默认。不同模型的差异
# 写在这里，不写死在 dock 里：
#   context_window     上下文窗口（顶栏占用与自动压缩的分母）。不写按 128k 估。
#   max_output_tokens  单次输出上限。不写不发；messages 后端例外——协议要求必填，
#                      不写兜底 16384。
#   reasoning          false = 这个模型没有推理档，任何推理字段都不发，/think 也
#                      扳不动它。不写 = 跟着运行时 /think 开关走。
#   reasoning_effort   切到该模型时的默认强度。不写 = 不发，用上游默认。
#   reasoning_efforts  /effort 菜单列哪几档。不写 = 列通用四档
#                      (low/medium/high/xhigh)；写 [] = 会推理但不接受档位参数，
#                      菜单空着、永不发 effort。
#   supports_images    false = 纯文本模型，图片（含工具结果里的截图）不进请求体。
#                      不写 = 当作支持。
#   [model."<id>".pricing]  单价，USD / 百万 token。写了 /usage 才算得出金额。
#                      input（未命中）/ cache_read / cache_write / output 四个价位，
#                      口径和 /usage 的分段一一对应。cache_write 省略按 input 算。
#                      **不内置任何厂商价格表**：价格变动频繁，猜出来的单价一旦
#                      过期就是静默给出错误金额，比不显示更糟。
#                      本地算出来的金额永远标「约 …（按 config 单价估算）」，不是
#                      账单：不含分时折扣（如 DeepSeek off-peak 半价）。上游若在
#                      响应里带了费用（目前只有 xAI），以上游为准且不加「约」。
#   prompt_cache       仅 messages 后端：true（默认）往 system / 对话尾部打
#                      cache_control 断点，长会话每轮省掉重复前缀的计费。自建
#                      /v1/messages 代理不认这个字段时置 false。另两条 wire 的
#                      前缀缓存由上游自动做，这个键对它们无效。

[models]
default = "dual-model"

# --- 1. 一个端点、多条协议（最常见的情况） ---
# 三条都开着：声明一次，`/protocol` 现场切。默认走 responses——推理链能跨轮
# 回放，长工具循环不丢思路。Anthropic 侧入口不同，写个协议块单独指过去；
# 其余的键（窗口、推理档、能不能读图）三条协议共用。
[model."dual-model"]
name = "多协议模型"
description = "<厂商> /responses + /chat/completions + /messages"
api_base_url = "https://<your-endpoint>/v1"
api_backends = ["responses", "chat_completions", "messages"]
api_model = "<上游真实模型名>"
env_key = "YOUR_API_KEY_ENV"
context_window = 200000
reasoning = true
reasoning_effort = "medium"
reasoning_efforts = ["low", "medium", "high"]

# 只覆盖连接：这条 wire 的基址不一样，鉴权也按网关要求改成 bearer。
[model."dual-model".messages]
api_base_url = "https://<your-endpoint>/anthropic"
auth_scheme = "bearer"

# 单价：抄你的厂商定价页，USD / 百万 token。省略整段 = /usage 显示「未上报」。
[model."dual-model".pricing]
input = 0.28
cache_read = 0.028
cache_write = 0.28
output = 0.42

# --- 2. 只支持 Chat Completions 的端点（自建代理、本地 ollama、多数长尾模型） ---
# 默认是 responses，这类端点**必须**显式声明，否则会打到一个不存在的路径。
[model."chat-model"]
name = "Chat 模型"
description = "<厂商> /chat/completions"
api_base_url = "https://<your-endpoint>/v1"
api_backend = "chat_completions"
env_key = "YOUR_API_KEY_ENV"
context_window = 128000

# --- 3. Messages（Anthropic 风格；max_tokens 必填，缓存要显式断点） ---
[model."messages-model"]
name = "Messages 模型"
description = "<厂商> /messages"
api_base_url = "https://<your-endpoint>/v1"
api_backend = "messages"
api_model = "<上游真实模型名>"
# 直连 Anthropic 风格端点可省略（默认跟着协议走 = x-api-key）；第三方网关多半
# 要 bearer。注意写了就对该模型的所有协议一律生效。
auth_scheme = "x_api_key"
env_key = "YOUR_API_KEY_ENV"
context_window = 200000
max_output_tokens = 16384
prompt_cache = true

# 纯文本模型的写法：明确关掉图片，否则截图类工具结果会被塞进请求体。
# [model."text-only-model"]
# api_base_url = "https://<your-endpoint>/v1"
# env_key = "YOUR_API_KEY_ENV"
# supports_images = false
# reasoning = false

# --- Computer / CUA: trycua cua-driver MCP (stdio) ---
# 装好 driver 就够了，这一段**不用写**：Dock 自己找 DOCK_CUA_DRIVER → PATH →
# ~/.local/bin → macOS /Applications/CuaDriver.app，找到就注入内置的
# [mcp_servers.cua-driver]（args = ["mcp"], enabled = true）。
# 还没装：开 /computer 按 i，走官方 https://cua.ai/driver/install.sh。
# DOCK_CUA_DRIVER=<绝对路径> 指定某一份；DOCK_CUA_DRIVER=off 关掉内置行。
# Tools appear as mcp_cua-driver__* (search_tool / use_tool); all gated like bash.
# Linux needs X11/XWayland (+ AT-SPI for get_window_state). No Docker.
# cua-driver 0.24+ speaks NDJSON. Dock stdio defaults to ndjson (no framing key needed).
# Legacy Content-Length servers only: framing = "content-length"
#
# 写下面这段只为覆盖内置行（换命令 / 固定绝对路径 / 关掉）——同名行整条生效：
# [mcp_servers.cua-driver]
# command = "cua-driver"
# args = ["mcp"]
# enabled = true

# --- Browser / BUA Chromium display ---
# Default headless (CI-safe). Toggle from /browser with `h`, or set here.
# DOCK_BROWSER_HEADED (any non-empty) overrides to headed at launch; empty/unset → use [browser].headed.
#
# [browser]
# headed = false

# --- Web 取回：web_fetch / web_search ---
# 每颗工具一节的 [toolset.<tool>]。取 ~/.dock/config.toml < 项目 .dock/config.toml，
# **逐字段**覆盖：项目只写 timeout_secs，不会把用户那份的 proxy_endpoint 清掉。
# 只列真正会生效的键；写认不出的键会被忽略并记一条 warn。
#
# [toolset.web_fetch]
# timeout_secs = 60          # 请求总超时。缺省 60；connect 恒 10s，不可配。
# max_content_length = 10485760   # 响应体上限（字节），缺省 10 MB。下完才判。
# max_markdown_length = 100000    # 喂给模型的 markdown 上限，缺省 100 000，超了截断并标 [truncated]。
# allowed_domains = ["docs.rs", "developer.mozilla.org"]
#                            # 只许这些域。**不写 = 不设这道闸**（SSRF 仍在）；
#                            # 写 [] = 全部拒绝，两者不是一个意思。
#                            # 对 web_search 不生效（它打的是自己的固定端点）。
# proxy_endpoint = "http://127.0.0.1:7890"
#                            # 转发代理。设上之后出口由代理解析，SSRF 的本地 DNS
#                            # 预检随之跳过——TUN + fake-ip（Clash/Surge）把公网域名
#                            # 解成 198.18.0.0/15 假址，不跳过会让每次取页面都被判 SSRF。
#                            # 代价：代理成为信任边界（本机代理会替你去连内网）。
#                            # IP 字面量（10.x / 127.x / 169.254.169.254）照旧拦。
# allow_local = false        # 只放行显式本地主机名（localhost / 127.0.0.0/8 / ::1）。
#                            # 私有段与云元数据地址永不放行。缺省 false。


# Cross-session memory (default off). Override with DOCK_MEMORY=1/0.
# [memory]
# enabled = false
# [memory.flush]
# enabled = true
# soft_threshold_tokens = 4000
# max_flush_write_chars = 8000
# [memory.dream]
# enabled = true
# min_hours = 24
# min_sessions = 5
# Optional embeddings for hybrid search (missing → FTS-only).
# [memory.embedding]
# model = "text-embedding-3-small"
# base = "https://api.openai.com/v1"
# dimensions = 1024
# api_key = ""   # or DOCK_MEMORY_EMBEDDING_API_KEY / OPENAI_API_KEY
